# ScriptureReel Server — Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to GitHub

# Server port (Railway/Render set this automatically)
PORT=3001

# Note: xAI API key is passed per-request from the dashboard
# in the x-api-key header — NOT stored on the server.
# This keeps your key secure and lets you rotate it anytime.
